{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pripy",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-27",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "pripy"
		}
	]
}
